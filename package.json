{
  "name": "ai-whodunit",
  "private": true,
  "version": "0.0.0",
  "description": "AI Whodunit — interrogate AI suspects grounded in a provably-solvable case engine, then accuse the culprit.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:contract": "turbo run test:contract",
    "test:e2e": "turbo run test:e2e",
    "test:smoke": "turbo run test:smoke",
    "test:visual": "turbo run test:visual",
    "eval": "turbo run eval",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
