{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "outputs": ["reports/mutation/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"]
    },
    "test:contract": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"]
    },
    "test:smoke": {
      "dependsOn": ["^build"]
    },
    "test:visual": {
      "dependsOn": ["^build"]
    },
    "eval": {
      "dependsOn": ["^build"]
    }
  }
}
